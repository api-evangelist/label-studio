          "name": "✨ Get organization members/roles",
          "request": {
            "name": "✨ Get organization members/roles",
            "description": {
              "content": "<Card href=\"https://humansignal.com/goenterprise\">\n        <img style=\"pointer-events: none; margin-left: 0px; margin-right: 0px;\" src=\"https://docs.humansignal.com/images/badge.svg\" alt=\"Label Studio Enterprise badge\"/>\n        <p style=\"margin-top: 10px; font-size: 14px;\">\n            This endpoint is not available in Label Studio Community Edition. [Learn more about Label Studio Enterprise](https://humansignal.com/goenterprise)\n        </p>\n    </Card>\nRetrieve a list of all users and roles in a specific organization.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "organizations",
                ":id",
                "memberships"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "contributed_to_projects",
                  "value": "<boolean>",
                  "description": "Whether to include projects created and contributed to by the members."
                },
                {
                  "disabled": false,
                  "key": "exclude_project_id",
                  "value": "<integer>",
                  "description": "Project ID to exclude users who are already associated with this project (direct members, workspace members, or implicit admin/owner access)."
                },
                {
                  "disabled": false,
                  "key": "exclude_workspace_id",
                  "value": "<integer>",
                  "description": "Workspace ID to exclude users who are already associated with this workspace (direct workspace members or implicit admin/owner access)."
                },
                {
                  "disabled": false,
                  "key": "ordering",
                  "value": "<string>",
                  "description": "Which field to use when ordering the results."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "A page number within the paginated result set."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "<integer>",
                  "description": "Number of results to return per page."
                },
                {
                  "disabled": false,
                  "key": "role",
                  "value": "<string>",
                  "description": "Filter members by organization role. Accepts single role or comma-separated list of roles.\n\n**Format:**\n- Single role: `?role=RE`\n- Multiple roles: `?role=AN,RE` (users with ANY of these roles)\n\n**Role Codes:**\n- `OW` = Owner\n- `AD` = Administrator\n- `MA` = Manager\n- `RE` = Reviewer\n- `AN` = Annotator\n- `NO` = Not Activated\n- `DI` = Disabled\n"
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "Member visibility scope. `accessible` (default) limits Managers to members in their projects/workspaces. `all` returns all organization members. Only affects Manager role."
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "A search term."
                },
                {
                  "disabled": false,
                  "key": "tags",
                  "value": "<string>",
                  "description": "Filter members by tags. Use a comma-separated list of tag IDs."
