                  "disabled": false,
                  "key": "job_id",
                  "value": "<integer>",
                  "description": "Optional job ID to retrieve specific job status"
                },
                {
                  "disabled": false,
                  "key": "project_id",
                  "value": "<integer>",
                  "description": "Optional project ID to retrieve the latest backfill status for that project. If omitted, returns aggregated organization status."
