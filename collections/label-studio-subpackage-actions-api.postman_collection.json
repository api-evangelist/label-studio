          "name": "Post actions",
          "request": {
            "name": "Post actions",
            "description": {
              "content": "Perform a Data Manager action with the selected tasks and filters. Note: More complex actions require additional parameters in the request body. Call `GET api/actions?project=<id>` to explore them. <br>Example: `GET api/actions?id=delete_tasks&project=1`",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "dm",
                "actions",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "(Required) Action name ID, see the full list of actions in the `GET api/actions` request"
                },
                {
                  "disabled": false,
                  "key": "project",
                  "value": "<integer>",
                  "description": "(Required) Project ID"
                },
                {
                  "disabled": false,
                  "key": "view",
                  "value": "<integer>",
                  "description": "View ID (optional, it has higher priority than filters, selectedItems and ordering from the request body payload)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filters\": {\n    \"conjunction\": \"<string>\",\n    \"items\": [\n      {\n        \"filter\": \"<string>\",\n        \"operator\": \"<string>\",\n        \"type\": \"<string>\",\n        \"value\": \"<string>\"\n      },\n      {\n        \"filter\": \"<string>\",\n        \"operator\": \"<string>\",\n        \"type\": \"<string>\",\n        \"value\": \"<string>\"\n      }\n    ]\n  },\n  \"ordering\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"selectedItems\": {\n    \"all\": \"<boolean>\",\n    \"included\": [\n      \"<integer>\",\n      \"<integer>\"\n    ]\n  }\n}",
